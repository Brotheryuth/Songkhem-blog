---
import logoImg from '../../assets/logo.png';
import { useTranslations, type Language } from '../../i18n/translations';

interface Props {
  currentPath?: string;
  lang?: Language;
}

const { currentPath = '/', lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === 'km' ? '/km#hero' : '/#hero';
const featuresPath = lang === 'km' ? '/km#features' : '/#features';
const storiesPath = lang === 'km' ? '/km#stories' : '/#stories';
const aboutPath = lang === 'km' ? '/km#about' : '/#about';
---

<header class="site-header" role="banner">
  <div class="container-max header-inner">
    <div class="brand-group">
      <a href={homePath} class="brand-link" aria-label="SongKhem home">
        <img src={logoImg.src} alt="SongKhem logo" width="34" height="34" class="brand-logo" />
        <span class="brand-title">SongKhem</span>
      </a>
    </div>

    <!-- Apple-Style Segmented Navigation Bar -->
    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li>
          <a
            href={homePath}
            class="nav-link active"
            data-nav-target="hero"
            data-i18n="nav.home"
          >
            {t('nav.home')}
          </a>
        </li>
        <li>
          <a
            href={featuresPath}
            class="nav-link"
            data-nav-target="features"
            data-i18n="nav.features"
          >
            {t('nav.features')}
          </a>
        </li>
        <li>
          <a
            href={storiesPath}
            class="nav-link"
            data-nav-target="stories"
            data-i18n="nav.stories"
          >
            {t('nav.stories')}
          </a>
        </li>
        <li>
          <a
            href={aboutPath}
            class="nav-link"
            data-nav-target="about"
            data-i18n="nav.about"
          >
            {t('nav.about')}
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Icon Language Toggle (Translate 文A Symbol) -->
      <button
        id="lang-toggle"
        class="icon-button"
        type="button"
        aria-label="Switch language between English and Khmer"
        title="Switch language / ប្តូរភាសា"
      >
        <svg class="nav-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
        </svg>
      </button>

      <!-- Icon Theme Toggle -->
      <button
        id="theme-toggle"
        class="icon-button"
        type="button"
        aria-label="Toggle visual theme"
        title="Toggle Light / Dark / High Contrast mode"
      >
        <!-- Light Theme Sun Icon -->
        <svg class="theme-icon icon-light" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.02-.39-1.41 0z"/>
        </svg>

        <!-- Dark Theme Moon Icon -->
        <svg class="theme-icon icon-dark" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/>
        </svg>

        <!-- Contrast Mode Split Circle Icon -->
        <svg class="theme-icon icon-contrast" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18V4c4.41 0 8 3.59 8 8s-3.59 8-8 8z"/>
        </svg>
      </button>

      <!-- Primary Try Now CTA -->
      <a
        href="https://ocr-for-impaired-user.vercel.app"
        class="app-button"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="hero.cta"
      >
        {t('hero.cta')}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    height: 68px;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand-group {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .brand-logo {
    width: 34px;
    height: 34px;
    object-fit: contain;
    display: block;
  }

  .brand-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--color-primary);
  }

  /* Apple-Style Segmented Capsule Navigation */
  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    background-color: var(--md-sys-color-surface-container);
    padding: 3px 4px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--md-sys-color-on-surface);
    background-color: rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="dark"]) .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
  }

  /* Apple Active Pill Indicator */
  .nav-link.active {
    background-color: #FFFFFF;
    color: #000000;
    font-weight: 600;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1), 0 0 1px rgba(0, 0, 0, 0.08);
  }

  :global([data-theme="dark"]) .nav-link.active {
    background-color: #282A2D;
    color: #FFFFFF;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="contrast"]) .nav-list {
    background-color: #000000;
    border: 2px solid #FFFF00;
  }

  :global([data-theme="contrast"]) .nav-link {
    color: #FFFF00;
  }

  :global([data-theme="contrast"]) .nav-link.active {
    background-color: #FFFF00;
    color: #000000 !important;
    font-weight: 700;
    box-shadow: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Circular Icon Buttons */
  .icon-button {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background-color: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .icon-button:hover {
    background-color: var(--md-sys-color-surface-container-high);
    transform: translateY(-1px);
  }

  .nav-icon {
    display: block;
    color: var(--color-primary);
  }

  /* Dynamic Theme Icon Visibility across <html> data-theme */
  .theme-icon {
    display: none;
    color: var(--md-sys-color-on-surface);
  }

  /* 1. Light Mode Default (Sun) */
  :global(:root:not([data-theme="dark"]):not([data-theme="contrast"])) .icon-light {
    display: block;
  }

  /* 2. Dark Mode (Moon) */
  :global([data-theme="dark"]) .icon-dark {
    display: block;
    color: var(--color-primary);
  }

  /* 3. Contrast Mode (Split Circle) */
  :global([data-theme="contrast"]) .icon-contrast {
    display: block;
    color: #FFFF00 !important;
  }

  .app-button {
    padding: 8px 20px;
    background-color: var(--color-primary);
    color: var(--md-sys-color-on-primary);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 600;
    margin-left: var(--space-2);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .app-button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Global High Contrast Theme Overrides */
  :global([data-theme="contrast"]) .site-header {
    border-bottom: 2px solid #FFFF00;
    background-color: #000000;
  }

  :global([data-theme="contrast"]) .brand-title,
  :global([data-theme="contrast"]) .nav-link.active,
  :global([data-theme="contrast"]) .nav-icon,
  :global([data-theme="contrast"]) .app-button {
    color: #FFFF00;
  }

  :global([data-theme="contrast"]) .icon-button {
    border: 2px solid #FFFF00;
    color: #FFFF00;
    background-color: #000000;
  }

  :global([data-theme="contrast"]) .app-button {
    background-color: #000000;
    border: 2px solid #FFFF00;
  }

  @media (max-width: 768px) {
    .nav-list {
      gap: var(--space-3);
    }
    .icon-button {
      width: 36px;
      height: 36px;
    }
    .app-button {
      padding: 6px 14px;
      font-size: 0.8125rem;
    }
  }
</style>
