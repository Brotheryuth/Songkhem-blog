---
import logoImg from '../../assets/logo.png';
import { useTranslations, type Language } from '../../i18n/translations';

interface Props {
  currentPath?: string;
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === 'km' ? '/km#hero' : '/#hero';
const featuresPath = lang === 'km' ? '/km#features' : '/#features';
const storiesPath = lang === 'km' ? '/km#stories' : '/#stories';
const aboutPath = lang === 'km' ? '/km#about' : '/#about';

const links = [
  { href: homePath, target: 'hero', key: 'nav.home' },
  { href: featuresPath, target: 'features', key: 'nav.features' },
  { href: storiesPath, target: 'stories', key: 'nav.stories' },
  { href: aboutPath, target: 'about', key: 'nav.about' },
] as const;
---

<!-- No header bar: the logo floats small at the top, and one round button opens the menu (the pages, the
     language and theme buttons, and the app). It takes no room, so every section can use the whole screen. -->
<header class="site-header" role="banner">
  <a href={homePath} class="brand-link" aria-label="SongKhem home">
    <img src={logoImg.src} alt="" width="26" height="26" class="brand-logo" />
    <span class="brand-title">SongKhem</span>
  </a>

  <div class="menu-anchor">
    <button id="menu-toggle" class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu">
      <span class="menu-label" data-i18n="nav.menu">{t('nav.menu')}</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>

    <div id="site-menu" class="menu-panel" hidden>
      <nav class="site-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {
            links.map((link, i) => (
              <li>
                <a href={link.href} class:list={['nav-link', { active: i === 0 }]} data-nav-target={link.target}>
                  <span data-i18n={link.key}>{t(link.key)}</span>
                  <span class="nav-num" aria-hidden="true">0{i + 1}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="menu-actions">
        <button
          id="lang-toggle"
          class="icon-button"
          type="button"
          aria-label="Switch language between English and Khmer"
          title="Switch language / ប្តូរភាសា"
        >
          <svg class="nav-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
          </svg>
        </button>

        <button
          id="theme-toggle"
          class="icon-button"
          type="button"
          aria-label="Toggle visual theme"
          title="Toggle Light / Dark / High Contrast mode"
        >
          <svg class="theme-icon icon-light" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.02-.39-1.41 0z"/>
          </svg>
          <svg class="theme-icon icon-dark" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
          <svg class="theme-icon icon-contrast" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18V4c4.41 0 8 3.59 8 8s-3.59 8-8 8z"/>
          </svg>
        </button>

        <a
          href="https://ocr-for-impaired-user.vercel.app"
          class="app-button"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="hero.cta"
        >
          {t('hero.cta')}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Takes no room: everything in it floats over the page (and only the logo and button catch clicks) */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    z-index: 60;
    pointer-events: none;
  }

  .brand-link,
  .menu-anchor {
    pointer-events: auto;
  }

  /* Phones: keep a clear strip at the top (nothing drawn) so the page starts below the logo and button */
  @media (max-width: 768px) {
    .site-header {
      position: sticky;
      height: 70px;
    }
  }

  /* The logo: small, top left, level with the menu button on the right; its name spaced out beside it */
  .brand-link {
    position: fixed;
    top: 14px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 8px;
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.7;
  }

  .brand-logo {
    display: block;
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  .brand-title {
    color: var(--md-sys-color-on-surface);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  /* The menu button, top right */
  .menu-anchor {
    position: fixed;
    top: 14px;
    right: 20px;
  }

  .menu-button {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 6px 0 16px;
    border: 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 14px rgba(15, 23, 42, 0.1);
    color: var(--md-sys-color-on-surface);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-icon {
    display: grid;
    place-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--md-sys-color-surface-container);
  }

  .menu-icon span {
    display: block;
    width: 12px;
    height: 1.5px;
    border-radius: 1px;
    background-color: currentColor;
    transition: transform 0.25s ease;
  }

  .menu-button[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* The menu */
  .menu-panel {
    position: absolute;
    top: 54px;
    right: 0;
    width: min(320px, calc(100vw - 32px));
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background-color: var(--color-surface);
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.18);
    transform-origin: top right;
    animation: menu-in 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .menu-panel[hidden] {
    display: none;
  }

  /* Moves in, never fades in: the menu is readable from its first frame, even on a slow device */
  @keyframes menu-in {
    from {
      transform: translateY(-6px) scale(0.97);
    }
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 14px;
    color: var(--md-sys-color-on-surface);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .nav-link:hover {
    background-color: var(--md-sys-color-surface-container);
  }

  .nav-link.active {
    background-color: var(--md-sys-color-surface-container);
  }

  .nav-num {
    color: var(--md-sys-color-on-surface-variant);
    font: 600 0.75rem/1 ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    letter-spacing: 0.1em;
  }

  .menu-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: 10px;
    padding: 12px 4px 2px;
    border-top: 1px solid var(--color-border);
  }

  .icon-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .icon-button:hover {
    background-color: var(--md-sys-color-surface-container-high);
  }

  .nav-icon {
    display: block;
    color: var(--color-primary);
  }

  .theme-icon {
    display: none;
    color: var(--md-sys-color-on-surface);
  }

  :global(:root:not([data-theme="dark"]):not([data-theme="contrast"])) .icon-light {
    display: block;
  }

  :global([data-theme="dark"]) .icon-dark {
    display: block;
    color: var(--color-primary);
  }

  :global([data-theme="contrast"]) .icon-contrast {
    display: block;
    color: #FFFF00 !important;
  }

  .app-button {
    margin-left: auto;
    padding: 9px 20px;
    border-radius: 999px;
    background-color: var(--color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: 0.875rem;
    font-weight: 600;
    transition: opacity 0.15s ease;
  }

  .app-button:hover {
    opacity: 0.9;
  }

  :global([data-theme="dark"]) .menu-panel {
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
  }

  /* High contrast: solid black and yellow, no see-through */
  :global([data-theme="contrast"]) .brand-title,
  :global([data-theme="contrast"]) .nav-link,
  :global([data-theme="contrast"]) .nav-num,
  :global([data-theme="contrast"]) .nav-icon {
    color: #FFFF00;
  }

  :global([data-theme="contrast"]) .menu-button,
  :global([data-theme="contrast"]) .menu-panel,
  :global([data-theme="contrast"]) .icon-button,
  :global([data-theme="contrast"]) .app-button {
    border: 2px solid #FFFF00;
    background-color: #000000;
    color: #FFFF00;
    backdrop-filter: none;
    box-shadow: none;
  }

  :global([data-theme="contrast"]) .menu-icon {
    background-color: #000000;
  }

  :global([data-theme="contrast"]) .nav-link.active,
  :global([data-theme="contrast"]) .nav-link:hover {
    background-color: #FFFF00;
    color: #000000;
  }

  :global([data-theme="contrast"]) .nav-link.active .nav-num,
  :global([data-theme="contrast"]) .nav-link:hover .nav-num {
    color: #000000;
  }
</style>

<script>
  // The menu: opens under its button, closes on Escape, a click outside, or choosing a page
  const button = document.getElementById('menu-toggle');
  const panel = document.getElementById('site-menu');

  if (button && panel) {
    const setOpen = (open: boolean, focusButton = false) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      if (open) panel.querySelector<HTMLElement>('.nav-link')?.focus();
      else if (focusButton) button.focus();
    };
    button.addEventListener('click', () => setOpen(panel.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false, true);
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !button.contains(e.target as Node) && !panel.contains(e.target as Node)) setOpen(false);
    });
    panel.querySelectorAll('.nav-link').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  }
</script>
