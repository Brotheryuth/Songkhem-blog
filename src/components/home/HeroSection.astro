---
import backgroundSvg from '../../assets/background.svg';
import cameraImg from '../../assets/camera-screen.png';
import readerImg from '../../assets/reader-screen.png';
import { useTranslations, type Language } from '../../i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="hero-section" aria-label="Introduction">
  <!-- Prominently Visible Khmer Pattern Backdrop (Adapts to Light, Dark, & Contrast) -->
  <div
    class="hero-bg-layer"
    style={`background-image: url(${backgroundSvg.src})`}
    aria-hidden="true"
  ></div>

  <div class="hero-container container-max">
    <!-- Left Column: Copy -->
    <div class="hero-content">
  

      <h1 class="hero-title" data-i18n="hero.title" class:list={[{ 'font-khmer': lang === 'km' }]}>
        {t('hero.title')}
      </h1>

      <p class="hero-description" data-i18n="hero.description" class:list={[{ 'font-khmer': lang === 'km' }]}>
        {t('hero.description')}
      </p>

      <div class="hero-actions">
        <a
          href="https://ocr-for-impaired-user.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          data-i18n="hero.cta"
        >
          {t('hero.cta')}
        </a>
      </div>
    </div>

    <!-- Right Column: Dual Screens (Moved Further to Right, Zero Borders) -->
    <div class="hero-visual" aria-hidden="true">
      <div class="device-frame device-camera">
        <img
          src={cameraImg.src}
          alt="SongKhem Camera Scanner"
          width={cameraImg.width}
          height={cameraImg.height}
          loading="eager"
        />
      </div>
      <div class="device-frame device-reader">
        <img
          src={readerImg.src}
          alt="SongKhem Karaoke Document Reader"
          width={readerImg.width}
          height={readerImg.height}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: var(--space-8) 0 calc(var(--space-8) + var(--space-5));
    background-color: var(--color-surface);
    overflow: hidden;
  }

  /* 1. Default Light Mode: Crisp Brand Blue Pattern */
  .hero-bg-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-repeat: repeat;
    background-size: 560px auto;
    background-position: center;
    opacity: 0.18;
    z-index: 0;
    mask-image: radial-gradient(ellipse 95% 85% at 50% 50%, #000 65%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 95% 85% at 50% 50%, #000 65%, transparent 100%);
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  /* 2. Dark Mode: Subtle White/Silver Pattern */
  :global([data-theme="dark"]) .hero-bg-layer {
    opacity: 0.18;
    filter: invert(1) brightness(0.75);
  }

  /* 3. Contrast Mode: Bright High-Contrast Yellow Pattern */
  :global([data-theme="contrast"]) .hero-bg-layer {
    display: block;
    opacity: 0.28;
    filter: invert(94%) sepia(93%) saturate(1352%) hue-rotate(359deg) brightness(106%) contrast(107%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 500px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .hero-title {
    font-size: clamp(2.35rem, 5vw, 3.6rem);
    line-height: 1.15;
    letter-spacing: -0.5px;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--md-sys-color-on-surface-variant);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    padding-top: var(--space-2);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: 1.0625rem;
    font-weight: 600;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  /* Right Column: Dual Screens (Zero Borders, Soft Natural Shadows) */
  .hero-visual {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: relative;
    padding: var(--space-5) 0;
    width: 100%;
    margin-left: auto;
  }

  .device-frame {
    position: relative;
    width: 50%;
    max-width: 330px;
    border: none !important;
    outline: none !important;
    filter: drop-shadow(0 24px 36px rgba(0, 0, 0, 0.16));
    transition: transform 0.3s ease;
  }

  .device-frame img {
    width: 100%;
    height: auto;
    display: block;
    border: none;
    border-radius: 0;
  }

  /* Staggered & angled cascade */
  .device-camera {
    transform: translateY(32px) rotate(-3deg);
    z-index: 1;
  }

  .device-reader {
    transform: translateY(-32px) rotate(2deg);
    z-index: 2;
    margin-left: -18px;
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }

    .hero-visual {
      transform: translateX(50px);
    }

    .device-frame {
      max-width: 340px;
    }

    .device-reader {
      margin-left: -20px;
    }
  }

  /* Large Desktop */
  @media (min-width: 1280px) {
    .hero-visual {
      transform: translateX(80px);
    }
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-content {
      max-width: 680px;
    }

    .hero-visual {
      justify-content: center;
      margin-top: var(--space-4);
      transform: none;
    }

    .device-frame {
      max-width: 290px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .hero-visual {
      justify-content: center;
      gap: 4px;
      transform: none;
    }

    .device-frame {
      max-width: 180px;
    }

    .device-camera {
      transform: translateY(12px) rotate(-2deg);
    }

    .device-reader {
      transform: translateY(-12px) rotate(1deg);
      margin-left: -8px;
    }
  }

  /* Dark Theme */
  :global([data-theme="dark"]) .device-frame {
    filter: drop-shadow(0 24px 44px rgba(0, 0, 0, 0.65));
  }

  /* High Contrast WCAG AAA - No Outlines or Borders on Images */
  :global([data-theme="contrast"]) .hero-badge {
    background-color: #FFFF00;
    color: #000000;
  }

  :global([data-theme="contrast"]) .btn-primary {
    background-color: #000000;
    border: 2px solid #FFFF00;
    color: #FFFF00;
  }

  :global([data-theme="contrast"]) .device-frame {
    filter: none;
    outline: none !important;
    border: none !important;
    box-shadow: none !important;
  }
</style>
