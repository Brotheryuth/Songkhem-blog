---
import backgroundSvg from '../../assets/background.svg';
import { useTranslations, type Language, type TranslationKey } from '../../i18n/translations';
import { APP_FONTS_CSS, ICONS, SIGNAL } from '../../scripts/app-screen';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// The app's own icons (lucide-react-native) as inline SVG, for the flat phones
const icon = (name: string, size: number, fill = 'none') =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="${fill}" stroke="${fill === 'none' ? 'currentColor' : fill}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]
    .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`)
    .join('')}</svg>`;
const signalIcon = `<svg width="23" height="28" viewBox="0 0 41 51" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">${SIGNAL.map((d) => `<path d="${d}"/>`).join('')}</svg>`;

const titleWords = ['រឿង', 'ព្រេង', '៖', 'ធនញ្ជ័យ'];
const bodyWords = [
  'កាលពី', 'ព្រេង', 'នាយ', 'មាន', 'កុមារ', 'ម្នាក់', 'ឈ្មោះធនញ្ជ័យ', 'ជា', 'ក្មេង', 'ឆ្លាតវៃ', 'និង', 'មាន',
  'ប្រាជ្ញាលើស', 'ក្មេង', 'ដទៃ', '។', 'ធនញ្ជ័យ', 'តែងតែយក', 'ចំណេះ', 'ដឹង', 'និង', 'ប្រាជ្ញា', 'ស្មារតី', 'របស់',
  'ខ្លួនមកដោះ', 'ស្រាយ', 'បញ្ហា', 'លំបាកៗ', 'ក្នុង', 'ភូមិ', 'និងជួយ', 'ដល់', 'ប្រជាជន', 'ស្លូត', 'ត្រង់', '។',
];
const pageTitle = 'រឿងព្រេង៖ ធនញ្ជ័យ';
const pageText =
  'កាលពីព្រេងនាយ មានកុមារម្នាក់ឈ្មោះធនញ្ជ័យ ជាក្មេងឆ្លាតវៃនិងមានប្រាជ្ញាលើសក្មេងដទៃ។ ធនញ្ជ័យតែងតែយកចំណេះដឹងនិងប្រាជ្ញាស្មារតីរបស់ខ្លួនមកដោះស្រាយបញ្ហាលំបាកៗក្នុងភូមិ និងជួយដល់ប្រជាជនស្លូតត្រង់។';

const steps: { title: TranslationKey; body: TranslationKey }[] = [
  { title: 'about.how.step1.title', body: 'about.how.step1.body' },
  { title: 'about.how.step2.title', body: 'about.how.step2.body' },
  { title: 'about.how.step3.title', body: 'about.how.step3.body' },
];

// Labels drawn on the 3D phone screen; kept in the page so the language button can swap them.
const screenText: Record<string, TranslationKey> = {
  search: 'scene.search',
  further: 'scene.tooClose',
  found: 'scene.ready',
  camera: 'scene.camera',
  upload: 'scene.upload',
  history: 'scene.history',
  scanningTitle: 'scene.scanningTitle',
  scanningDesc: 'scene.scanningDesc',
  progress: 'scene.progress',
  readerTitle: 'scene.readerTitle',
  voice: 'scene.voice',
};
---

<section id="hero" class="story" aria-label="Introduction" data-story>
  <div class="story-stage" data-stage>
    <div class="story-bg" style={`background-image: url(${backgroundSvg.src})`} aria-hidden="true"></div>
    <canvas class="story-canvas" data-canvas aria-hidden="true"></canvas>

    <div class="story-inner container-max">
      <div class="story-copy" data-copy>
        <h1 class="story-title" data-i18n="hero.title">{t('hero.title')}</h1>
        <p class="story-description" data-i18n="hero.description">{t('hero.description')}</p>
        <a
          href="https://ocr-for-impaired-user.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          data-i18n="hero.cta"
        >
          {t('hero.cta')}
        </a>
      </div>

      <!-- Flat picture of the real app (same layout as app-screen.ts, in dp, scaled to fit), shown when the
           3D scene is off: less motion, no WebGL or no JavaScript. -->
      <link rel="stylesheet" href={APP_FONTS_CSS} />
      <div class="story-scene" aria-hidden="true" data-scene>
        <div class="phone phone-camera">
          <div class="phone-glass">
            <div class="app">
              <div class="app-status app-status-header">
                <span>9:41</span><span class="status-icons"><i class="s-wifi"></i><i class="s-signal"></i><i class="s-battery"></i></span>
              </div>
              <div class="app-header">
                <img class="app-logo" src="/app-ui/logo-mark.png" alt="" width="32" height="32" />
                <span class="app-name">SongKhem</span>
                <span class="app-actions"><Fragment set:html={icon('languages', 22)} /><Fragment set:html={icon('help', 22)} /><Fragment set:html={icon('settings', 22)} /></span>
              </div>
              <div class="app-deck">
                <div class="cam-frame">
                  <div class="cam-page">
                    <p class="cam-page-title">{pageTitle}</p>
                    <p class="cam-page-text">{pageText}</p>
                  </div>
                  <div class="cam-guide">
                    <span class="cam-guide-icon"><Fragment set:html={icon('scan', 18)} /></span>
                    <span data-i18n="scene.ready">{t('scene.ready')}</span>
                  </div>
                  <span class="cam-shutter"></span>
                </div>
              </div>
              <div class="app-tabs">
                <span class="app-tab is-on"><span class="tab-pill"><Fragment set:html={icon('camera', 24)} /></span><span data-i18n="scene.camera">{t('scene.camera')}</span></span>
                <span class="app-tab"><span class="tab-pill"><Fragment set:html={icon('upload', 24)} /></span><span data-i18n="scene.upload">{t('scene.upload')}</span></span>
                <span class="app-tab"><span class="tab-pill"><Fragment set:html={icon('history', 24)} /></span><span data-i18n="scene.history">{t('scene.history')}</span></span>
              </div>
              <span class="nav-handle"></span>
            </div>
          </div>
        </div>

        <div class="phone phone-reader">
          <div class="phone-glass">
            <div class="app">
              <div class="app-status">
                <span>9:41</span><span class="status-icons"><i class="s-wifi"></i><i class="s-signal"></i><i class="s-battery"></i></span>
              </div>
              <div class="reader-bar">
                <Fragment set:html={icon('back', 24)} />
                <span data-i18n="scene.readerTitle">{t('scene.readerTitle')}</span>
                <Fragment set:html={icon('settings', 22)} />
              </div>
              <div class="reader-text">
                <p>{titleWords.map((word) => <><span class="word">{word}</span>{' '}</>)}</p>
                <p>{bodyWords.map((word, index) => <><span class:list={['word', { 'is-on': index === 9 }]}>{word}</span>{' '}</>)}</p>
              </div>
              <span class="reader-fab"><Fragment set:html={signalIcon} /></span>
              <div class="player">
                <div class="player-head">
                  <span class="voice-tag"><Fragment set:html={icon('volume', 15)} /><span data-i18n="scene.voice">{t('scene.voice')}</span></span>
                  <Fragment set:html={icon('more', 20)} />
                </div>
                <span class="player-track"><span class="player-fill"></span></span>
                <div class="player-times"><span>0:04</span><span>-0:12</span></div>
                <div class="player-controls">
                  <span class="ctl"><Fragment set:html={icon('skipBack', 24)} /></span>
                  <span class="ctl ctl-play"><Fragment set:html={icon('pause', 30, '#FFFFFF')} /></span>
                  <span class="ctl"><Fragment set:html={icon('skipForward', 24)} /></span>
                </div>
              </div>
              <span class="nav-handle"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="story-captions" data-captions>
      <div class="captions-progress" aria-hidden="true">
        {steps.map(() => <span class="captions-segment"><span class="captions-fill" data-caption-fill></span></span>)}
      </div>
      <ol class="captions-steps" role="list">
        {steps.map((step, index) => (
          <li class="caption" data-caption>
            <span class="caption-number" aria-hidden="true">{index + 1}</span>
            <div>
              <h2 class="caption-title" data-i18n={step.title}>{t(step.title)}</h2>
              <p class="caption-body" data-i18n={step.body}>{t(step.body)}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div hidden data-screen-text>
      {Object.entries(screenText).map(([name, key]) => <span data-name={name} data-i18n={key}>{t(key)}</span>)}
    </div>
  </div>
</section>

<style>
  .story {
    --story-top: 68px;
    --ps: 0.82;
    position: relative;
    background-color: var(--color-surface);
  }

  .story-stage {
    position: relative;
    overflow: hidden;
  }

  .story-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-repeat: repeat;
    background-size: 560px auto;
    background-position: center;
    opacity: 0.18;
    mask-image: radial-gradient(ellipse 95% 85% at 50% 50%, #000 65%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 95% 85% at 50% 50%, #000 65%, transparent 100%);
  }

  :global([data-theme="dark"]) .story-bg {
    filter: invert(1) brightness(0.75);
  }

  :global([data-theme="contrast"]) .story-bg {
    opacity: 0.28;
    filter: invert(94%) sepia(93%) saturate(1352%) hue-rotate(359deg) brightness(106%) contrast(107%);
  }

  .story-canvas,
  .story-captions {
    display: none;
  }

  .story-inner {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-top: var(--space-8);
    padding-bottom: calc(var(--space-8) + var(--space-5));
  }

  .story-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 520px;
  }

  .story-title {
    font-size: clamp(2.35rem, 5vw, 3.6rem);
    line-height: 1.15;
    letter-spacing: -0.5px;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
  }

  .story-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--md-sys-color-on-surface-variant);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-2);
    padding: 16px 36px;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: 1.0625rem;
    font-weight: 600;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  :global([data-theme="contrast"]) .btn-primary {
    background-color: #000000;
    border: 2px solid #FFFF00;
    color: #FFFF00;
  }

  @media (min-width: 1024px) {
    .story-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
  }

  @media (max-width: 1023px) {
    .story {
      --ps: 0.66;
    }
  }

  @media (max-width: 600px) {
    .story {
      --ps: 0.5;
    }
  }

  /* ---------- Flat phones (fallback): the real app, laid out in dp like app-screen.ts ---------- */
  .story-scene {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-5) 0;
  }

  .phone {
    position: relative;
    flex: none;
    width: 300px;
    height: 627px;
    margin: calc(-313px * (1 - var(--ps))) calc(-150px * (1 - var(--ps)));
    padding: 10px;
    border-radius: 46px;
    background: linear-gradient(145deg, #2C3A5E, #18264F 45%, #111B38);
    box-shadow: inset 0 0 0 2px #3A4A73, inset 0 0 0 5px #05070D, 0 24px 36px rgba(0, 0, 0, 0.16);
  }

  /* punch-hole selfie camera */
  .phone::before {
    content: '';
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 22px;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, #3A4060 0 18%, #07080D 30%);
  }

  .phone-camera {
    z-index: 1;
    transform: translateY(32px) scale(var(--ps)) rotate(-3deg);
  }

  .phone-reader {
    z-index: 2;
    margin-left: calc(-150px * (1 - var(--ps)) - 20px);
    transform: translateY(-32px) scale(var(--ps)) rotate(2deg);
  }

  .phone-glass {
    width: 280px;
    height: 607px;
    overflow: hidden;
    border-radius: 36px;
    background: #F8FAFC;
  }

  /* The app at its real size (411 x 891 dp), scaled to the glass */
  .app {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 411px;
    height: 891px;
    transform: scale(calc(280 / 411));
    transform-origin: 0 0;
    background: #F8FAFC;
    color: #0F172A;
    font-family: 'Roboto', 'Noto Sans Khmer', sans-serif;
    letter-spacing: 0;
  }

  .app :global(svg) {
    flex: none;
    display: block;
  }

  .app-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 32px 0 31px;
    flex: none;
    font-size: 14.5px;
    color: #1F1F1F;
  }

  .app-status-header {
    background: #FFFFFF;
  }

  .status-icons {
    display: flex;
    align-items: flex-end;
    gap: 5px;
  }

  .s-wifi {
    width: 15px;
    height: 11px;
    background: #1F1F1F;
    clip-path: polygon(50% 100%, 0 25%, 15% 8%, 50% 0, 85% 8%, 100% 25%);
  }

  .s-signal {
    width: 11px;
    height: 12px;
    background: #1F1F1F;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .s-battery {
    width: 8px;
    height: 14px;
    border-radius: 1.5px;
    background: #1F1F1F;
  }

  .app-header {
    display: flex;
    align-items: center;
    height: 64px;
    padding: 0 16px;
    flex: none;
    background: #FFFFFF;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: #444746;
  }

  .app-logo {
    width: 32px;
    height: 32px;
    margin: 0 14px 0 2px;
  }

  .app-name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #1F1F1F;
  }

  .app-actions {
    display: flex;
    gap: 26px;
    margin: 0 11px 0 auto;
  }

  .app-deck {
    flex: 1;
    margin: 8px;
    padding: 8px;
    border-radius: 16px;
    background: #F8FAFC;
  }

  .cam-frame {
    position: relative;
    height: 100%;
    overflow: hidden;
    border: 2px solid #E2E8F0;
    border-radius: 12px;
    background:
      repeating-linear-gradient(92deg, rgba(43, 26, 15, 0.22) 0 2px, transparent 2px 13px),
      radial-gradient(ellipse at 40% 30%, #9A7351 0%, #6E4C31 55%, #4A321F 100%);
  }

  .cam-page {
    position: absolute;
    left: 50%;
    top: 47%;
    width: 268px;
    height: 356px;
    margin: -178px 0 0 -134px;
    padding: 24px 22px;
    background: #FBF8EF;
    color: #1B1B1B;
    font-family: 'Kantumruy Pro', 'Noto Sans Khmer', sans-serif;
    outline: 4px solid #EF4444;
    outline-offset: 2px;
    transform: rotate(-2deg);
  }

  .cam-page-title {
    margin-bottom: 8px;
    text-align: center;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.8 !important;
  }

  .cam-page-text {
    font-size: 12px;
    line-height: 2 !important;
  }

  .cam-guide {
    position: absolute;
    top: 14px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 24px);
    padding: 7px 14px;
    transform: translateX(-50%);
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    background: rgba(23, 27, 34, 0.85);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.28);
    color: #FFFFFF;
    font-size: 13.6px;
    font-weight: 500;
    line-height: 18px !important;
    letter-spacing: 0.1px;
  }

  .cam-guide-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(168, 199, 250, 0.16);
    color: #A8C7FA;
  }

  .cam-shutter {
    position: absolute;
    left: 50%;
    bottom: 14px;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    border: 4px solid #FFFFFF;
    border-radius: 50%;
    background: radial-gradient(circle, #FFFFFF 0 24px, rgba(255, 255, 255, 0.2) 24.5px);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.28);
  }

  .app-tabs {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 104px;
    padding: 0 16px 24px;
    flex: none;
    background: #F0F4F9;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    color: #444746;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px !important;
    letter-spacing: 0.1px;
  }

  .app-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 120px;
  }

  .tab-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 32px;
    border-radius: 16px;
  }

  .app-tab.is-on {
    color: #041E49;
    font-weight: 600;
  }

  .app-tab.is-on .tab-pill {
    background: #C2E7FF;
  }

  .nav-handle {
    position: absolute;
    left: 50%;
    bottom: 8.5px;
    width: 108px;
    height: 4px;
    margin-left: -54px;
    border-radius: 2px;
    background: #1F1F1F;
  }

  .reader-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 20px;
    flex: none;
    background: #FFFFFF;
    border-bottom: 1px solid #CBD5E1;
    font-family: 'Suwannaphum', 'Noto Sans Khmer', serif;
    font-size: 19px;
    font-weight: 700;
  }

  .reader-text {
    flex: 1;
    padding: 20px;
    font-family: 'Suwannaphum', 'Noto Sans Khmer', serif;
    font-size: 18px;
  }

  .reader-text p {
    margin-bottom: 24px;
    line-height: 1.85 !important;
  }

  .word.is-on {
    padding: 6px 0;
    background: #FEF08A;
  }

  .reader-fab {
    position: absolute;
    right: 18px;
    bottom: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 1px solid #3353E2;
    border-radius: 50%;
    background: #4466F6;
    box-shadow: 0 4px 12px rgba(68, 102, 246, 0.35);
  }

  .player {
    flex: none;
    height: 194px;
    padding: 8px 16px 34px;
    background: #FFFFFF;
    border-top: 1px solid #CBD5E1;
    color: #334155;
  }

  .player-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding: 0 16px 0 4px;
  }

  .voice-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 10px;
    border-radius: 9999px;
    background: rgba(148, 163, 184, 0.14);
    font-family: 'Suwannaphum', 'Noto Sans Khmer', serif;
    font-size: 12px;
    font-weight: 700;
  }

  .player-track {
    position: relative;
    display: block;
    height: 4px;
    margin: 16px 0 12px;
    border-radius: 9999px;
    background: rgba(148, 163, 184, 0.35);
  }

  .player-fill {
    position: absolute;
    inset: 0 75% 0 0;
    border-radius: 9999px;
    background: #4466F6;
  }

  .player-fill::after {
    content: '';
    position: absolute;
    right: -6px;
    top: -4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #4466F6;
  }

  .player-times {
    display: flex;
    justify-content: space-between;
    margin-top: -6px;
    font-size: 12px;
    font-weight: 600;
  }

  .player-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 36px;
    margin-top: 2px;
  }

  .ctl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #F1F5F9;
  }

  .ctl-play {
    width: 56px;
    height: 56px;
    background: #3353E2;
    box-shadow: 0 4px 12px rgba(68, 102, 246, 0.4);
  }

  /* ---------- 3D scene: pinned, and every part moves with the scroll ---------- */
  .story.is-live {
    height: 560svh;
  }

  .is-live .story-stage {
    position: sticky;
    top: var(--story-top);
    height: calc(100svh - var(--story-top));
  }

  .is-live .story-inner {
    position: static;
    height: 100%;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .is-live .story-scene {
    display: none;
  }

  .is-live .story-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1023px), (orientation: portrait) {
    .is-live .story-inner {
      align-items: start;
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Captions */
  .is-live .story-captions {
    display: block;
    position: absolute;
    z-index: 3;
    opacity: 0;
    visibility: hidden;
    left: max(var(--space-5), calc((100% - var(--container-max)) / 2 + var(--space-5)));
    top: 50%;
    width: min(400px, 32%);
    transform: translateY(-50%);
  }

  .captions-progress {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .captions-segment {
    flex: 1;
    height: 4px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: var(--md-sys-color-outline-variant);
  }

  .captions-fill {
    display: block;
    height: 100%;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .captions-steps {
    display: grid;
  }

  .caption {
    grid-area: 1 / 1;
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .caption.is-current {
    opacity: 1;
  }

  .caption-number {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background-color: #FEF08A;
    color: #1F1F1F;
    font-weight: 700;
  }

  .caption-title {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.2;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
  }

  .caption-body {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--md-sys-color-on-surface-variant);
  }

  :global([data-theme="contrast"]) .caption-number {
    background-color: #FFFF00;
    color: #000000;
  }

  /* Narrow screens: captions sit in a compact band along the bottom. */
  @media (max-width: 1023px), (orientation: portrait) {
    .is-live .story-captions {
      left: 0;
      right: 0;
      top: auto;
      bottom: 0;
      width: auto;
      transform: none;
      padding: var(--space-3) var(--space-4) var(--space-4);
      background-color: #041E49;
      --md-sys-color-on-surface: #FFFFFF;
      --md-sys-color-on-surface-variant: #C2E7FF;
      --md-sys-color-outline-variant: rgba(255, 255, 255, 0.28);
      --color-primary: #FEF08A;
    }

    .captions-progress {
      margin-bottom: var(--space-3);
    }

    .caption-title {
      font-size: 1.25rem;
    }

    .caption-body {
      margin-top: var(--space-1);
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    :global([data-theme="dark"]) .is-live .story-captions {
      background-color: #0B2A5B;
    }

    :global([data-theme="contrast"]) .is-live .story-captions {
      background-color: #000000;
      border-top: 2px solid #FFFF00;
      --md-sys-color-on-surface-variant: #FFFF00;
      --color-primary: #FFFF00;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caption,
    .btn-primary {
      transition: none;
    }
  }
</style>

<script>
  import type { Frame, SceneText } from '../../scripts/phone-scene';

  const root = document.querySelector<HTMLElement>('[data-story]');

  const supportsWebGL = () => {
    try {
      const probe = document.createElement('canvas');
      return !!probe.getContext('webgl2');
    } catch {
      return false;
    }
  };

  // The 3D scene is extra: it only starts when motion is welcome, the screen is tall enough and WebGL works.
  const wanted =
    root &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
    window.innerHeight >= 500 &&
    supportsWebGL();

  if (root && wanted) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const copy = root.querySelector<HTMLElement>('[data-copy]')!;
    const cta = copy.querySelector<HTMLAnchorElement>('.btn-primary')!;
    const captionBox = root.querySelector<HTMLElement>('[data-captions]')!;
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    const fills = [...root.querySelectorAll<HTMLElement>('[data-caption-fill]')];
    const textBox = root.querySelector<HTMLElement>('[data-screen-text]')!;
    const header = document.querySelector<HTMLElement>('.site-header');

    const readText = () =>
      Object.fromEntries(
        [...textBox.querySelectorAll<HTMLElement>('[data-name]')].map((el) => [el.dataset.name, el.textContent ?? ''])
      ) as SceneText;

    const clamp = (v: number, a = 0, b = 1) => Math.min(Math.max(v, a), b);
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const show = (el: HTMLElement, opacity: number) => {
      el.style.opacity = String(opacity);
      el.style.visibility = opacity <= 0.01 ? 'hidden' : 'visible';
    };

    const start = async () => {
      const { createPhoneScene } = await import('../../scripts/phone-scene');
      const scene = await createPhoneScene(canvas, readText());

      // Switch on the pinned layout without moving what the visitor is looking at.
      const before = root.offsetHeight;
      const wasPast = window.scrollY > root.offsetTop + before;
      root.classList.add('is-live');
      if (wasPast) window.scrollBy(0, root.offsetHeight - before);

      let wide = false;

      const frame = (): Frame => {
        root.style.setProperty('--story-top', `${header?.offsetHeight ?? 0}px`);
        copy.style.transform = '';
        const W = stage.clientWidth;
        const H = stage.clientHeight;
        wide = W >= 1024 && W > H;
        const pad = W >= 768 ? 24 : 16;
        const cw = Math.min(W, 1200);
        const left = (W - cw) / 2 + pad;
        const right = (W + cw) / 2 - pad;
        if (wide) {
          const half = left + (right - left) * 0.5;
          const mainLeft = left + (right - left) * 0.36;
          return {
            W, H,
            hero: { x: half, y: H * 0.08, w: right - half, h: H * 0.84 },
            main: { x: mainLeft, y: 0, w: W - mainLeft - (W - right) * 0.5, h: H },
          };
        }
        const stageTop = stage.getBoundingClientRect().top;
        const copyBottom = copy.getBoundingClientRect().bottom - stageTop + 8;
        const band = captionBox.offsetHeight;
        return {
          W, H,
          hero: { x: 0, y: copyBottom, w: W, h: Math.max(H - copyBottom, 140) },
          main: { x: 0, y: 0, w: W, h: H - band },
        };
      };

      const progress = () => {
        const distance = root.offsetHeight - stage.offsetHeight;
        const top = header?.offsetHeight ?? 0;
        return clamp((top - root.getBoundingClientRect().top) / distance);
      };

      const paint = (p: number) => {
        const out = ease(seg(p, 0.03, 0.12));
        copy.style.transform = wide ? `translateX(${-48 * out}px)` : `translateY(${-32 * out}px)`;
        show(copy, 1 - out);
        cta.tabIndex = out > 0.5 ? -1 : 0;

        show(captionBox, ease(seg(p, 0.12, 0.2)));
        const step = p < 0.41 ? 0 : p < 0.58 ? 1 : 2;
        captions.forEach((caption, index) => caption.classList.toggle('is-current', index === step));
        const ranges = [[0.18, 0.41], [0.41, 0.58], [0.62, 0.95]];
        fills.forEach((fill, index) => {
          fill.style.transform = `scaleX(${seg(p, ranges[index][0], ranges[index][1])})`;
        });

        const state = scene.render(p);
        root.dataset.progress = p.toFixed(3);
        root.dataset.pageInView = String(state?.inside ?? 0);
      };

      let target = 0;
      let current = 0;
      let raf = 0;
      const tick = () => {
        raf = 0;
        // Light easing turns mouse wheel steps into smooth motion.
        current += (target - current) * 0.3;
        if (Math.abs(target - current) < 0.0005) current = target;
        paint(current);
        if (current !== target) raf = requestAnimationFrame(tick);
      };
      const onScroll = () => {
        target = progress();
        if (!raf) raf = requestAnimationFrame(tick);
      };
      const onResize = () => {
        scene.resize(frame());
        current = target = progress();
        paint(current);
      };

      onResize();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize);
      const observer = new ResizeObserver(onResize);
      if (header) observer.observe(header);
      observer.observe(copy);

      // Redraw the phone screen when the language button swaps the labels.
      new MutationObserver(() => {
        scene.setText(readText());
        paint(current);
      }).observe(textBox, { subtree: true, childList: true, characterData: true });
    };

    start().catch(() => {
      // If anything goes wrong, the flat version stays in place.
      root.classList.remove('is-live');
    });
  }
</script>
